<UserControl x:Class="BankReceiptsManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Margin="24">
        <StackPanel MaxWidth="700">
            <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="#0A2540" Margin="0,0,0,16"/>
            <TextBlock Text="Report folder (must contain the four source files)" FontWeight="SemiBold"/>
            <TextBox Text="{Binding ReportsFolder}" Margin="0,4,0,12" Padding="6"/>
            <TextBlock Text="PI report filename" FontWeight="SemiBold"/>
            <TextBox Text="{Binding PiFileName}" Margin="0,4,0,12" Padding="6"/>
            <TextBlock Text="HDR report filename" FontWeight="SemiBold"/>
            <TextBox Text="{Binding HdrFileName}" Margin="0,4,0,12" Padding="6"/>
            <TextBlock Text="Conveyancing report filename" FontWeight="SemiBold"/>
            <TextBox Text="{Binding ConvFileName}" Margin="0,4,0,12" Padding="6"/>
            <TextBlock Text="Mailinfo filename (.xlsx or .xls)" FontWeight="SemiBold"/>
            <TextBox Text="{Binding MailInfoFileName}" Margin="0,4,0,12" Padding="6"/>
            <TextBlock Text="Storage folder (for later milestones)" FontWeight="SemiBold"/>
            <TextBox Text="{Binding StorageFolder}" Margin="0,4,0,12" Padding="6"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Save Settings" Command="{Binding SaveCommand}" Background="#00A86B"/>
                <Button Content="Reload" Command="{Binding LoadCommand}" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding SaveMessage}" Margin="0,12,0,0" FontStyle="Italic"/>
            <TextBlock Text="Email sending is disabled in this Milestone 1 build." Margin="0,16,0,0" Foreground="#666"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
