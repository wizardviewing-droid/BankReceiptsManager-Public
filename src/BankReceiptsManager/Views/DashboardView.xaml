<UserControl x:Class="BankReceiptsManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:BankReceiptsManager.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Daily Receipt Processing" FontSize="26" FontWeight="Bold" Foreground="#0A2540" Margin="0,0,0,12"/>

        <!-- Summary cards -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,16">
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,8" MinWidth="160">
                <StackPanel>
                    <TextBlock Text="Imported" Foreground="#666" FontSize="12"/>
                    <TextBlock Text="{Binding TotalImported}" FontSize="28" FontWeight="Bold" Foreground="#0066CC"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,8" MinWidth="180">
                <StackPanel>
                    <TextBlock Text="Total Value" Foreground="#666" FontSize="12"/>
                    <TextBlock Text="{Binding TotalValue, StringFormat='£{0:N2}'}" FontSize="28" FontWeight="Bold" Foreground="#00A86B"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,8" MinWidth="140">
                <StackPanel>
                    <TextBlock Text="Matched" Foreground="#666" FontSize="12"/>
                    <TextBlock Text="{Binding MatchedCount}" FontSize="28" FontWeight="Bold" Foreground="#00A86B"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,8" MinWidth="160">
                <StackPanel>
                    <TextBlock Text="Requires Review" Foreground="#666" FontSize="12"/>
                    <TextBlock Text="{Binding ReviewCount}" FontSize="28" FontWeight="Bold" Foreground="#FF8C00"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16" MinWidth="140">
                <StackPanel>
                    <TextBlock Text="Unmatched" Foreground="#666" FontSize="12"/>
                    <TextBlock Text="{Binding UnmatchedCount}" FontSize="28" FontWeight="Bold" Foreground="#DC3545"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Import controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox Text="{Binding SelectedFilePath}" Width="420" IsReadOnly="True" Padding="8" Margin="0,0,8,0"/>
            <Button Content="Browse..." Command="{Binding BrowseFileCommand}" Margin="0,0,8,0"/>
            <Button Content="Import &amp; Match" Command="{Binding ImportAndMatchCommand}" Background="#00A86B" FontWeight="Bold" Padding="16,8"/>
            <Button Content="Re-run Matching" Command="{Binding ReRunMatchingCommand}" Margin="8,0,0,0"/>
            <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" Margin="16,0,0,0" FontStyle="Italic" Foreground="#0066CC"/>
        </StackPanel>

        <!-- Filters + table -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="160" SelectedValue="{Binding Filter}" SelectedValuePath="Content">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="Matched"/>
                    <ComboBoxItem Content="Requires Review"/>
                    <ComboBoxItem Content="Unmatched"/>
                </ComboBox>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredReceipts}"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      RowHeight="28"
                      AlternatingRowBackground="#F8F9FA"
                      GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      RowDetailsVisibilityMode="VisibleWhenSelected">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding DateFormatted}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding AmountFormatted}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Details" Binding="{Binding TransactionDetails}" Width="280" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Customer Ref" Binding="{Binding CustomerReference}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Extracted Ref" Binding="{Binding ExtractedReference}" Width="110" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Manual Reference" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ManualReference, UpdateSourceTrigger=LostFocus}"
                                         LostFocus="ManualReference_LostFocus"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="100" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="File Handler" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.FileHandlers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding FileHandler, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          SelectionChanged="FileHandlerCombo_SelectionChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Email" Binding="{Binding EmailAddress}" Width="180" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Notify To" Binding="{Binding NotificationRecipient}" Width="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding AllocationSource}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding MatchingNotes}" Width="200" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Match" Command="{Binding DataContext.MatchSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="4,2" FontSize="11" Margin="0,0,2,0" Background="#0066CC"/>
                                    <Button Content="Split" Command="{Binding DataContext.ExpandSplitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="4,2" FontSize="11" Margin="0,0,2,0"/>
                                    <Button Content="Clear" Command="{Binding DataContext.ClearManualCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="4,2" FontSize="11" Margin="0,0,2,0"/>
                                    <Button Content="Remove" Command="{Binding DataContext.RemoveReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="4,2" FontSize="11" Background="#DC3545"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Allocated" Binding="{Binding AllocatedFormatted}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingFormatted}" Width="100" IsReadOnly="True"/>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="#F0F4F8" Padding="12" Margin="4" CornerRadius="4" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding AmountFormatted, StringFormat='Original receipt: {0}'}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding AllocatedFormatted, StringFormat='Allocated: {0}'}"/>
                                <TextBlock Text="{Binding RemainingFormatted, StringFormat='Remaining: {0}'}" FontWeight="SemiBold"/>
                                <TextBlock Text="OVERALLOCATED – cannot finalise" Foreground="Red" FontWeight="Bold"
                                           Visibility="{Binding IsOverAllocated, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Fully allocated (exact)" Foreground="Green" FontWeight="Bold"
                                           Visibility="{Binding IsFullyAllocated, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="Add Allocation Line" Command="{Binding DataContext.AddAllocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Margin="0,8,0,4" HorizontalAlignment="Left"/>
                                <ItemsControl ItemsSource="{Binding Allocations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding CaseReference, UpdateSourceTrigger=PropertyChanged}" ToolTip="Proclaim reference"/>
                                                <TextBox Grid.Column="1" Text="{Binding AllocatedAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" ToolTip="Amount"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Department}" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.FileHandlers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding FileHandler, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/>
                                                <TextBlock Grid.Column="4" Text="{Binding NotificationRecipient}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                                    <Button Content="Match" Command="{Binding DataContext.MatchAllocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Margin="2,0" Padding="4,2"/>
                                                    <Button Content="Remove" Command="{Binding DataContext.RemoveAllocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Margin="2,0" Padding="4,2" Background="#DC3545"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Save Draft / Refresh Totals" Command="{Binding DataContext.RefreshAllocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Margin="0,8,0,0" HorizontalAlignment="Left" Background="#00A86B"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="RequiresReview">
                                <Setter Property="Background" Value="#FFF3CD"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Unmatched">
                                <Setter Property="Background" Value="#F8D7DA"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
