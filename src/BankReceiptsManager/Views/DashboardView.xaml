<UserControl x:Class="BankReceiptsManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Yellow header matching reference -->
        <Border Grid.ColumnSpan="2" Background="#F5C518" Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="true solicitors" FontSize="20" FontWeight="Bold" Foreground="#0A2540" VerticalAlignment="Center"/>
                <TextBlock Text="  |  Receipts Manager" FontSize="18" Foreground="#0A2540" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Navy sidebar -->
        <Border Grid.Row="1" Background="#0A2540" Padding="0,16">
            <StackPanel>
                <TextBlock Text="Daily Receipts" FontWeight="Bold" Margin="16,8" Padding="8" Background="#F5C518" Foreground="#0A2540"/>
                <TextBlock Text="Unreferenced Money" Foreground="White" Margin="16,4" Padding="8"/>
                <TextBlock Text="Receipt History" Foreground="White" Margin="16,4" Padding="8"/>
                <TextBlock Text="Reports" Foreground="White" Margin="16,4" Padding="8"/>
                <TextBlock Text="Settings" Foreground="White" Margin="16,4" Padding="8"/>
            </StackPanel>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Daily Receipts" FontSize="22" FontWeight="Bold" Foreground="#0A2540"/>
            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="0,4,0,12" Foreground="#666"/>

            <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                <Border Background="White" Padding="12" Margin="0,0,8,0" MinWidth="120">
                    <StackPanel>
                        <TextBlock Text="Imported" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding TotalImported}" FontSize="22" FontWeight="Bold" Foreground="#0A2540"/>
                    </StackPanel>
                </Border>
                <Border Background="White" Padding="12" Margin="0,0,8,0" MinWidth="140">
                    <StackPanel>
                        <TextBlock Text="Total Value" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding TotalValue, StringFormat='£{0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#0A2540"/>
                    </StackPanel>
                </Border>
                <Border Background="White" Padding="12" Margin="0,0,8,0" MinWidth="100">
                    <StackPanel>
                        <TextBlock Text="Matched" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding MatchedCount}" FontSize="22" FontWeight="Bold" Foreground="#00A86B"/>
                    </StackPanel>
                </Border>
                <Border Background="White" Padding="12" Margin="0,0,8,0" MinWidth="120">
                    <StackPanel>
                        <TextBlock Text="Review" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding ReviewCount}" FontSize="22" FontWeight="Bold" Foreground="#FF8C00"/>
                    </StackPanel>
                </Border>
                <Border Background="White" Padding="12" MinWidth="100">
                    <StackPanel>
                        <TextBlock Text="Unmatched" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding UnmatchedCount}" FontSize="22" FontWeight="Bold" Foreground="#DC3545"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredReceipts}" AutoGenerateColumns="False"
                      CanUserResizeColumns="True" RowHeight="28" AlternatingRowBackground="#F8F9FA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding DateFormatted}" Width="90"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding AmountFormatted}" Width="100"/>
                    <DataGridTextColumn Header="Bank Details" Binding="{Binding TransactionDetails}" Width="*"/>
                    <DataGridTextColumn Header="Extracted Ref" Binding="{Binding ExtractedReference}" Width="110"/>
                    <DataGridTemplateColumn Header="Manual Reference" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ManualReference, UpdateSourceTrigger=LostFocus}"
                                         LostFocus="ManualReference_LostFocus"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Match" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Match" Command="{Binding DataContext.MatchSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="File Handler" Binding="{Binding FileHandler}" Width="140"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTemplateColumn Header="Actions" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Split" Command="{Binding DataContext.ExpandSplitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#F0F0F0" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SaveStatus}" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
