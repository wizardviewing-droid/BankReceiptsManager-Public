<UserControl x:Class="BankReceiptsManager.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Import Bank Receipts" FontSize="28" FontWeight="Bold" Foreground="#0A2540" Margin="0,0,0,16"/>
            <TextBlock Text="Select the Barclays iPortal 'BACS CHAPS RECEIPTS' .xls export." Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox Text="{Binding SelectedFilePath}" Width="500" IsReadOnly="True" Margin="0,0,8,0" Padding="8"/>
                <Button Content="Browse..." Command="{Binding BrowseFileCommand}"/>
                <Button Content="Import" Command="{Binding ImportReceiptsCommand}" Margin="8,0,0,0" Background="#00A86B"/>
            </StackPanel>
            <TextBlock Text="{Binding ImportMessage}" Margin="0,0,0,16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ImportedCount, StringFormat='Imported: {0} receipts'}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding ImportedTotal, StringFormat='Total value: {0:C2}'}"/>
        </StackPanel>
    </Grid>
</UserControl>
