<Window x:Class="BankReceiptsManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BankReceiptsManager.ViewModels"
        xmlns:views="clr-namespace:BankReceiptsManager.Views"
        Title="Receipts Manager" Height="800" Width="1400"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#F5F7FA">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportViewModel}">
            <views:ImportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navy sidebar -->
        <Border Background="#0A2540" Grid.Column="0">
            <StackPanel Margin="16">
                <TextBlock Text="BANK RECEIPTS" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,24"/>
                <Button Content="Dashboard" Command="{Binding NavigateDashboardCommand}" Style="{StaticResource SidebarButton}"/>
                <Button Content="Import Bank Receipts" Command="{Binding NavigateImportCommand}" Style="{StaticResource SidebarButton}"/>
                <Button Content="Review Allocations" Command="{Binding NavigateReviewCommand}" Style="{StaticResource SidebarButton}"/>
                <Button Content="Send Notifications" Style="{StaticResource SidebarButton}" IsEnabled="False"/>
                <Button Content="Unreferenced Money" Style="{StaticResource SidebarButton}" IsEnabled="False"/>
                <Button Content="Company Enquiries" Style="{StaticResource SidebarButton}" IsEnabled="False"/>
                <Button Content="Return Payments" Style="{StaticResource SidebarButton}" IsEnabled="False"/>
                <Button Content="Receipt History" Style="{StaticResource SidebarButton}" IsEnabled="False"/>
                <Button Content="Reports" Style="{StaticResource SidebarButton}" IsEnabled="False"/>
                <Button Content="Settings" Command="{Binding NavigateSettingsCommand}" Style="{StaticResource SidebarButton}"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#A0C4FF" Margin="0,32,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
